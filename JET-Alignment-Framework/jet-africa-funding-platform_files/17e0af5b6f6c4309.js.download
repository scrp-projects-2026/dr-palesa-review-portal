t.defineProperty(n,r,{enumerable:!0,get:i[r]});let a=e.r(55682),o=e.r(8927),s=e.r(5500),l=a._(e.r(1948));function c(e){let{props:t}=(0,o.getImgProps)(e,{defaultLoader:l.default,imgConf:{deviceSizes:[640,750,828,1080,1200,1920,2048,3840],imageSizes:[32,48,64,96,128,256,384],qualities:[75],path:"/_next/image",loader:"default",dangerouslyAllowSVG:!1,unoptimized:!1}});for(let[e,n]of Object.entries(t))void 0===n&&delete t[e];return{props:t}}let d=s.Image},57688,(e,t,n)=>{t.exports=e.r(94909)},83431,e=>{e.v({"back-button":"faq-module__TywXvG__back-button","bottom-actions":"faq-module__TywXvG__bottom-actions",chevron:"faq-module__TywXvG__chevron","faq-answer":"faq-module__TywXvG__faq-answer","faq-group":"faq-module__TywXvG__faq-group","faq-groups":"faq-module__TywXvG__faq-groups","faq-illustration":"faq-module__TywXvG__faq-illustration","faq-item":"faq-module__TywXvG__faq-item","faq-page":"faq-module__TywXvG__faq-page","faq-question":"faq-module__TywXvG__faq-question","faq-shell":"faq-module__TywXvG__faq-shell",intro:"faq-module__TywXvG__intro","intro-text":"faq-module__TywXvG__intro-text",open:"faq-module__TywXvG__open","question-list":"faq-module__TywXvG__question-list","section-heading":"faq-module__TywXvG__section-heading","section-links":"faq-module__TywXvG__section-links","skip-link":"faq-module__TywXvG__skip-link","support-box":"faq-module__TywXvG__support-box","top-actions":"faq-module__TywXvG__top-actions","window-label":"faq-module__TywXvG__window-label"})},79860,e=>{"use strict";var t=e.i(43476),n=e.i(57688),i=e.i(22016),r=e.i(71645);let a=[{id:"platform",title:"About the JET Funding Platform",shortTitle:"About the platform",description:"How the Platform works and what it does.",faqs:[{id:"what-is-the-platform",question:"What is the JET Funding Platform?",answer:`The JET Funding Platform is a coordination and matchmaking mechanism housed within the Just Energy Transition (JET) Project Management Unit (PMU) in the Presidency, established to support South Africa’s Just Energy Transition. It improves access to grant funding for small-scale community projects, capacity-building initiatives and social enterprises that benefit communities and workers most directly affected by the transition away from coal, while also supporting SMMEs to diversify into low-carbon and climate-resilient activities.

The JET Funding Platform does not provide funding directly. Instead, it acts as an aggregator and matchmaker, identifying credible projects, supporting their readiness, and connecting them with aligned grant funders.

The JET Funding Platform has run three funding windows to date and received hundreds of proposals from a wide range of organisations and sectors. It is currently working to match approved projects with interested funders.

The Next Phase
Our experience to date has shown the depth of energy, creativity and commitment across society to advancing a genuinely just energy transition. The diversity of proposals received in previous windows highlighted both the strength of the pipeline and the value of a more focused, themed approach. The JET Funding Platform has, therefore, introduced themed funding windows targeting specific aspects of the transition. This enables faster assessments, allows for the involvement of relevant sector experts, and supports stronger, more informed funding decisions. We open this window with a strong sense of optimism that there are credible and impactful agriculture and food-system projects ready to be supported.`},{id:"does-the-platform-disburse-grants",question:"Does the JET Funding Platform provide or disburse grants directly?",answer:"No. The JET Funding Platform does not hold or disburse grants. Its role is to match selected, high-quality projects with appropriate funding partners. Selection into later stages does not guarantee funding."},{id:"can-the-process-change",question:"Can the JET Funding Platform change the process or timelines?",answer:"Yes. The JET Funding Platform reserves the right to amend timelines and requirements at its discretion."}]},{id:"window",title:"This Call / Funding Window",shortTitle:"This funding window",description:"Window 4 priorities, objectives and geographic focus.",faqs:[{id:"what-is-window-4-about",question:"What is this Call for Expressions of Interest (EOI) about?",answer:`Window 4 focuses on agriculture and food systems, with a circular economy dimension expressed within agriculture (principally waste-to-value pathways such as composting and biogas). It responds to clear demand for agricultural support across the JET Funding Platform’s earlier windows and helps coal-affected communities move from dependence on coal toward diversified, locally owned agricultural livelihoods, with a focus on former mine workers, women and youth. Window 4 is limited to grant funding.

This EOI invites organizations to submit community-led agriculture and food-system projects that build sustainable livelihoods and jobs, develop the agricultural value chain, and turn waste into value, in communities affected by South Africa’s Just Energy Transition (JET).`},{id:"window-main-focus",question:"What is the main focus of this funding window?",answer:`This themed window focuses on Agriculture and Food Systems, with a Circular Economy Dimension, prioritizing:

• Community-led agricultural production and food systems
• Development of the whole agricultural value chain, beyond primary production
• Circular, waste-to-value pathways embedded within agricultural projects`},{id:"window-objectives",question:"What are the key objectives of this window?",answer:`The key objectives of this window are:

• To create sustainable jobs and livelihoods for coal-affected communities, including former mine workers, through agricultural production, processing and aggregation
• To support direct landholder participation, empowering farmers to develop and use land they own or control
• To develop the whole agricultural value chain, so that farmers and local enterprises capture more of the value they create
• To embed circular, waste-to-value pathways (composting, biogas, organic-waste reuse, land rehabilitation) within funded projects`},{id:"circular-economy-dimension",question:"What is the circular economy dimension of this window?",answer:"Circular economy in Window 4 means turning crop, food and organic waste into compost, fertiliser or energy within agricultural projects, closing the loop between production, processing and inputs. It is embedded within agriculture rather than treated as a separate sectoral theme."},{id:"geographic-priorities",question:"Which geographic areas are prioritised?",answer:`Window 4 adopts a national lens: projects from anywhere in South Africa are eligible and will be assessed on merit.

Primary preference: Coal-affected communities in Mpumalanga, within reach of the Eskom decommissioning sites and the coal value chain.

Secondary preference: National initiatives elsewhere in South Africa.`}]},{id:"eligibility",title:"Applicant Eligibility",shortTitle:"Applicant eligibility",description:"Who may apply and the legal requirements.",faqs:[{id:"who-is-eligible",question:"Who is eligible to apply?",answer:`Eligible applicants include:

• Community-based organisations
• Cooperatives
• Non-profit organisations (NPOs / NGOs)
• Small, medium and micro enterprises (SMMEs)
• Community trusts or similar community-controlled legal vehicles

Applicants must be an appropriately registered legal entity and tax compliant with SARS (a valid Tax Compliance Status). This is checked first, before any assessment is conducted. Applicants that are not appropriately registered and tax compliant will not be assessed. Where communal or community-owned land is used, a single managing entity must be identified to hold and manage the project on the community’s behalf. Applicants must demonstrate a relevant track record in agriculture, food systems or community enterprise, or a credible delivery partner. Experience in Mpumalanga is an advantage.`},{id:"who-is-not-eligible",question:"Who is not eligible to apply?",answer:`The following are excluded:

• Individuals
• Political parties
• Pure research or feasibility-only proposals
• Projects whose only realistic financing route is a loan, equity or concessional debt
• Projects for which livestock or small-ruminant farming is the standalone primary purpose (such activity is supported only where it is incidental and waste-generating within a wider agricultural project)`}]},{id:"application",title:"Application and Selection Process",shortTitle:"Application process",description:"Submission, assessment, scoring and due diligence.",faqs:[{id:"submit-eoi",question:"How do I submit my EOI?",answer:"Applicants must register on the JET Funding Platform, complete the required online form, and upload all required supporting documents directly on the JET Funding Platform."},{id:"selection-process",question:"What is the selection process?",answer:`The process includes:

• EOI submission via the JET Funding Platform portal
• Eligibility screening and assessment against the gating requirements
• Shortlisting of the highest-scoring EOIs, up to a maximum of 35, by an Adjudication Committee
• Invitation to the shortlisted applicants to submit a full application
• Scoring of full applications by the Project Selection Committee (PSC)
• Virtual engagements with shortlisted applicants
• Final approval by the Project Review Committee (PRC)
• Communication of outcomes and funder matching

Up to 35 applicants will be invited to submit a full application.`},{id:"application-scoring",question:"How are EOIs and full applications scored?",answer:"Window 4 uses a two-stage evaluation. Stage 1 assesses the EOI out of 50 (relevance, design and viability). Only EOIs scoring at least 30 out of 50 are eligible, and the highest-scoring, up to a maximum of 35, are invited to submit a full application. Stage 2 assesses the full application out of 130 across seven sections. Scoring produces a ranking, not a final funding decision."},{id:"eoi-criteria",question:"What criteria will be used to assess EOIs?",answer:`EOIs will be assessed against:

• Alignment with the Window 4 theme, objectives and geographic focus
• Inclusion of women, youth and former mine workers
• Land access and a credible route to market
• Circular / waste-to-value integration
• Feasibility, readiness and risk
• Value-chain participation and commercial sustainability
• Potential impact and sustainability
• Organisational capacity, governance and compliance
• Value for money and leverage of co-funding
• Monitoring, evaluation and learning (MEL) approach`},{id:"late-or-incomplete-submission",question:"What happens if my submission exceeds the page limit or is incomplete?",answer:"Submissions that are late or are missing required sections may be disqualified and may not be considered."},{id:"due-diligence",question:"Will due diligence be conducted?",answer:"Yes. Shortlisted applicants (up to 35) will undergo Know-Your-Customer (KYC) and due-diligence checks, including governance, tax and other compliance checks. Participation in this process does not constitute an offer of funding."}]},{id:"funding",title:"Funding Parameters",shortTitle:"Funding parameters",description:"Grant range, timing, co-funding and disbursement.",faqs:[{id:"funding-range",question:"What is the funding range?",answer:"Projects may request between R500,000 and R20 million, subject to funder requirements and the nature of the project."},{id:"project-duration",question:"What is the maximum recommended project duration?",answer:"Projects may run for up to 36 months, recognising that agriculture typically needs a multi-year runway, subject to funder requirements and the nature of the project."},{id:"co-funding",question:"Is co-funding required?",answer:"Co-funding is encouraged but not mandatory. It may take the form of blended grants from more than one grant-maker, corporate social investment (CSI), or socio-economic development (SED) and social-spend grants, rather than concessional or commercial debt. Applicants should clearly indicate the source, amount and status of any existing or potential co-funding."},{id:"fund-disbursement",question:"How will funds be disbursed?",answer:`The JET Funding Platform is a matchmaker, not a grant maker. It supports approved projects to identify and engage funders aligned with their work, while also enabling funders to find credible projects that match their funding priorities.

Any grant disbursement is managed by the matched funder and is milestone-based, aligned with agreed deliverables and reporting requirements, and subject to the funder’s terms and conditions.`}]},{id:"project-types",title:"Priority Project Types",shortTitle:"Priority projects",description:"The agriculture and circular-economy projects prioritised.",faqs:[{id:"priority-project-types",question:"What types of projects are prioritised?",answer:`Priority is given to community-led agriculture projects across the following focus areas:

• Smallholder and cooperative crop production
• Agro-processing and value addition (milling, drying, packaging, cold storage)
• Community food hubs and market infrastructure (aggregation, grading, bulk sales to institutional buyers)
• Regenerative agriculture and land rehabilitation on degraded or mine-affected land
• Organic waste-to-value: community-scale composting and biogas
• Agricultural skills and enterprise development, including business, financial-literacy and cash-flow management support
• Climate-smart and controlled-environment agriculture, including hydroponics`}]},{id:"gender",title:"Gender Lens Investing (GLI) Benchmarks",shortTitle:"Gender benchmarks",description:"How gender inclusion is measured and improved.",faqs:[{id:"gender-benchmarks",question:"What are the gender benchmarks?",answer:`Benchmarks include:

• At least 30% women in leadership positions
• At least 40% women in overall employment
• At least 25% women ownership
• At least 30% of products or services directly benefiting women`},{id:"why-gender-benchmarks-matter",question:"Why are these gender-based benchmarks important?",answer:`Gender Lens Investing (GLI) benchmarks are integrated into the assessment framework to ensure gender inclusion and social impact are measurable, transparent and comparable, alongside environmental and financial performance. Their primary purpose is to support consistent data collection, accountability and evidence-based decision-making across the portfolio.

Projects are assessed against standard gender-related indicators covering women’s leadership, employment, ownership and beneficiary reach. These benchmarks provide a common reference point for portfolio-level comparison and learning, without making gender performance an exclusive eligibility criterion, allowing flexibility across different project types and stages.

GLI indicators function as a portfolio-level measurement and learning tool, enabling aggregation, comparison and tracking of progress over time. For the EOI, only a broad gender-impact description is required; for full applications, a GLI benchmark will be applied to the project or organisation.`},{id:"meet-all-gender-benchmarks",question:"Are projects required to meet all the gender-based benchmarks?",answer:"Not necessarily. Projects may be assessed against one or more applicable benchmarks, depending on their nature, sector and operational model. Meeting at least one benchmark may qualify a project as contributing to gender-inclusive outcomes."},{id:"measure-gender-compliance",question:"How is compliance with these gender-based benchmarks measured?",answer:`Compliance is measured using verifiable data such as:

• Organisational employment and leadership records
• Shareholding or ownership documentation
• Beneficiary data
• Periodic monitoring and reporting metrics`},{id:"improve-gender-performance",question:"Can a project improve its benchmark performance over time?",answer:"Yes. Projects are encouraged to adopt a progressive improvement approach, with targets reviewed periodically to reflect growth, transformation and enhanced social impact."},{id:"gender-benchmark-benefits",question:"How do these gender-based benchmarks benefit investors and stakeholders?",answer:`For investors and stakeholders, these benchmarks:

• Improve transparency and comparability across projects
• Reduce social risk
• Support responsible investment decisions
• Demonstrate measurable commitment to inclusive growth`}]},{id:"impact",title:"Impact and Monitoring, Evaluation and Learning (MEL) Benchmarks",shortTitle:"Impact & MEL",description:"The portfolio-level indicators used to measure impact.",faqs:[{id:"impact-benchmarks",question:"What impact benchmarks are projects assessed against?",answer:`Projects are assessed against measurable impact benchmarks across the areas below. For the EOI, only a broad impact description is required; for full applications, detailed benchmarks (with full definitions) will be applied.

Community involvement
• Share of interventions that plan for community involvement as part of their design
• Share of interventions reporting ‘Level 3 – community engagement’ (on a scale of 0 to 5) or higher

Institutional strengthening and capacity building
• Share of interventions reporting a positive change across institutional elements (capacity, systems, resources, information, coordination) at community/local, provincial or national level

Job creation
• Number of non-permanent full-time-equivalent (FTE) jobs created or maintained
• Number of permanent FTE jobs created or maintained

Livelihoods and resilience
• Share of interventions self-reporting livelihood contributions ‘on track’ or better in planned asset categories
• Number of households estimated to have benefitted from the intervention

Gender equality
• At least 30% women in leadership positions
• At least 40% women in overall employment
• At least 25% women ownership
• At least 30% of products or services directly benefiting women`},{id:"why-impact-benchmarks-matter",question:"Why are these impact benchmarks important?",answer:"These core benchmarks are integrated into the assessment framework to ensure inclusion and social impact are measurable, transparent and comparable, alongside environmental and financial performance. They support consistent data collection, accountability and evidence-based decision-making across the portfolio. As with the gender benchmarks, they are a portfolio-level measurement and learning tool rather than an exclusive eligibility criterion, allowing flexibility across project types, contexts and stages."},{id:"meet-all-impact-benchmarks",question:"Are projects required to meet all the impact benchmarks?",answer:"Not necessarily. Projects may be assessed against one or more applicable benchmarks, depending on their nature, sector and operational model. Meeting at least one benchmark may qualify a project as contributing to social-impact outcomes. Compliance is measured, and improvement is encouraged, in the same way as for the gender benchmarks above."}]},{id:"support",title:"Support and Enquiries",shortTitle:"Support",description:"Where applicants can get help and clarification.",faqs:[{id:"contact-for-queries",question:"Who can I contact for queries or clarification?",answer:`The JET Funding Platform Team is available to support applicants with questions about the application process, eligibility criteria and other aspects of the funding window.

Applicants may submit questions via the JET PMU contact box or email the JET Funding Platform Team at helpdesk@jetfundingplatform.org.za`}]}];a.flatMap(e=>e.faqs.map(t=>({...t,categoryId:e.id,categoryTitle:e.title})));var o=e.i(83431);let s="helpdesk@jetfundingplatform.org.za",l=new Set(["The Next Phase","Community involvement","Institutional strengthening and capacity building","Job creation","Livelihoods and resilience","Gender equality"]);function c({answer:e}){let n=[],i=[];function r(){i.length&&(n.push((0,t.jsx)("ul",{children:i.map(e=>(0,t.jsx)("li",{children:e},e))},`list-${n.length}`)),i=[])}return e.split("\n").forEach((e,a)=>{let o=e.trim();o?o.startsWith("•")?i.push(o.replace(/^•\s*/,"")):(r(),n.push(l.has(o)?(0,t.jsx)("h4",{children:o},a):(0,t.jsx)("p",{children:o},a))):r()}),r(),(0,t.jsx)(t.Fragment,{children:n})}function d({id:e,question:n,answer:i}){let[a,s]=(0,r.useState)(!1),l=`${e}-answer`;return(0,t.jsxs)("article",{className:o.default["faq-item"],children:[(0,t.jsx)("h3",{children:(0,t.jsxs)("button",{type:"button",className:o.default["faq-question"],"aria-expanded":a,"aria-controls":l,onClick:()=>s(e=>!e),children:[(0,t.jsx)("span",{children:n}),(0,t.jsx)("svg",{"aria-hidden":"true",className:`${o.default.chevron} ${a?o.default.open:""}`,viewBox:"0 0 24 24",fill:"none",stroke:"currentColor",strokeWidth:"2",strokeLinecap:"round",strokeLinejoin:"round",children:(0,t.jsx)("path",{d:"m6 9 6 6 6-6"})})]})}),(0,t.jsx)("div",{id:l,className:o.default["faq-answer"],hidden:!a,children:(0,t.jsx)(c,{answer:i})})]})}function u(){return(0,t.jsxs)("div",{className:o.default["faq-shell"],children:[(0,t.jsx)("a",{href:"#faq-content",className:o.default["skip-link"],children:"Skip to FAQs"}),(0,t.jsxs)("main",{id:"faq-content",className:o.default["faq-page"],children:[(0,t.jsx)("div",{className:o.default["top-actions"],children:(0,t.jsx)(i.default,{href:"/login",className:o.default["back-button"],children:"Back to Login"})}),(0,t.jsxs)("header",{className:o.def